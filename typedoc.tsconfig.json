{
    "$schema": "http://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "module": "preserve",
        "strict": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM"]
    },
    "include": ["packages/*/src/*.ts", "packages/*/src/*.d.ts"],
    "exclude": [
        "node_modules",
        "**/dist/**",
        "**/test/**",
        "packages/full/**",
        "packages/renderer-vue/playground",
        "packages/themes/**"
    ]
}
